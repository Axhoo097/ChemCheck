// ============================================
// ChemCheck – Prisma Database Schema (SQLite compatible, stringified JSON)
// 12 models with SQLite-compatible types (no Json type)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Models ----

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  passwordHash  String?
  googleId      String?   @unique
  avatarUrl     String?
  role          String    @default("USER") // USER, ADMIN, MODERATOR
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile        UserProfile?
  reviews        Review[]
  reactions      UserReaction[]
  recommendations Recommendation[]
  notifications  Notification[]
  favorites      UserFavorite[]
  comparisons    ProductComparison[]
  adminLogs      AdminLog[]

  @@index([email])
  @@index([googleId])
  @@map("users")
}

model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  skinType     String?  // OILY, DRY, COMBINATION, SENSITIVE, NORMAL
  hairType     String?  // OILY, DRY, NORMAL, CURLY, STRAIGHT, WAVY, COILY
  allergies    String   @default("[]") // JSON stringified array of strings
  dietaryPrefs String   @default("[]") // JSON stringified array of strings
  goals        String   @default("[]") // JSON stringified array of strings
  age          Int?
  gender       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Product {
  id          String          @id @default(uuid())
  barcode     String?         @unique
  name        String
  brand       String
  category    String          // GROCERY, COSMETIC, SKINCARE, HAIRCARE, FOOD, BEVERAGE, PERSONAL_CARE, BABY_CARE, HOUSEHOLD
  description String?
  imageUrl    String?
  source      String          @default("MANUAL") // OPEN_FOOD_FACTS, MANUAL, BARCODE_SCAN, OCR_SCAN
  status      String          @default("PENDING") // PENDING, APPROVED, REJECTED
  country     String?         @default("India")
  nutriScore  String?
  novaGroup   Int?
  metadata    String?         // JSON stringified object
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  ingredients    ProductIngredient[]
  toxicityReport ToxicityReport?
  reviews        Review[]
  recommendations Recommendation[]
  favorites      UserFavorite[]
  comparisons1   ProductComparison[] @relation("Product1")
  comparisons2   ProductComparison[] @relation("Product2")

  @@index([barcode])
  @@index([name])
  @@index([brand])
  @@index([category])
  @@index([status])
  @@map("products")
}

model Ingredient {
  id           String   @id @default(uuid())
  name         String   @unique
  inciName     String?
  casNumber    String?  @unique
  riskScore    Int      @default(0) // 0-100
  category     String   @default("General")
  description  String?
  healthEffects String  @default("[]") // JSON stringified array
  alternatives String   @default("[]") // JSON stringified array
  sources      String   @default("[]") // JSON stringified array
  aliases      String   @default("[]") // JSON stringified array
  isNatural    Boolean  @default(false)
  isBanned     Boolean  @default(false)
  bannedIn     String   @default("[]") // JSON stringified array
  ewgScore     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products  ProductIngredient[]
  reactions UserReaction[]

  @@index([name])
  @@index([inciName])
  @@index([riskScore])
  @@map("ingredients")
}

model ProductIngredient {
  id            String  @id @default(uuid())
  productId     String
  ingredientId  String
  concentration Float?
  position      Int     @default(0) // order in ingredient list

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

model ToxicityReport {
  id                 String    @id @default(uuid())
  productId          String    @unique
  overallScore       Float
  riskLevel          String    // BEST, BETTER, WORST
  aiSummary          String
  harmfulIngredients String    @default("[]") // JSON stringified array
  safeIngredients    String    @default("[]") // JSON stringified array
  warnings           String    @default("[]") // JSON stringified array
  detailedScores     String?   // JSON stringified object
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([riskLevel])
  @@map("toxicity_reports")
}

model Review {
  id           String   @id @default(uuid())
  userId       String
  productId    String
  rating       Int      // 1-5
  title        String?
  comment      String
  helpfulCount Int      @default(0)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
  @@map("reviews")
}

model UserReaction {
  id           String           @id @default(uuid())
  userId       String
  ingredientId String
  reactionType String
  severity     String           // MILD, MODERATE, SEVERE
  notes        String?
  date         DateTime         @default(now())
  productUsed  String?
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ingredientId])
  @@map("user_reactions")
}

model Recommendation {
  id        String   @id @default(uuid())
  userId    String
  productId String
  reason    String
  score     Float
  category  String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([score])
  @@map("recommendations")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      String           // PRODUCT_ALERT, RECOMMENDATION, REVIEW_REPLY, SYSTEM
  title     String
  message   String
  read      Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("user_favorites")
}

model ProductComparison {
  id         String   @id @default(uuid())
  userId     String
  product1Id String
  product2Id String
  notes      String?
  createdAt  DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product1 Product @relation("Product1", fields: [product1Id], references: [id], onDelete: Cascade)
  product2 Product @relation("Product2", fields: [product2Id], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("product_comparisons")
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  metadata   String?  // JSON stringified object
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entityType])
  @@index([createdAt])
  @@map("admin_logs")
}
