# Copy this file to .env and fill in real values. Never commit .env itself.

APP_NAME=ChemCheck
ENVIRONMENT=development

# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://chemcheck:chemcheck@localhost:5432/chemcheck

# Generate a real random secret for this, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Phase 9 — Optional Redis score cache (leave blank to disable caching)
REDIS_URL=redis://localhost:6379/0

# Phase 9 — Optional LLM explanation layer (leave blank to disable /explain endpoint)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
